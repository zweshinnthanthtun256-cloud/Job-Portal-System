FROM node:20-alpine AS frontend
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY resources ./resources
COPY public ./public
COPY vite.config.js ./
RUN pnpm run build

FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-scripts

FROM php:8.3-fpm-alpine
RUN apk add --no-cache icu-dev libzip-dev nginx supervisor gettext && docker-php-ext-install intl mbstring pdo_pgsql opcache zip
WORKDIR /var/www/html
COPY . .
COPY --from=vendor /app/vendor ./vendor
COPY --from=frontend /app/public/build ./public/build
COPY docker/render/nginx.conf.template /etc/nginx/http.d/default.conf.template
COPY docker/render/supervisord.conf /etc/supervisord.conf
COPY docker/render/start.sh /usr/local/bin/render-start
RUN chmod +x /usr/local/bin/render-start && chown -R www-data:www-data storage bootstrap/cache
EXPOSE 10000
CMD ["render-start"]
